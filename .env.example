# Existing Redis Cloud database: use its redis:// or rediss:// connection URL.
REDIS_URL=
# Keep this existing database; use a unique namespace for this project and a different one for Preview.
WORLD_NAMESPACE=minecraftgra-production-v1
# Optional own-world compressed snapshot cap: 6 MiB by default, allowed 1–12 MiB.
WORLD_REDIS_MAX_SNAPSHOT_BYTES=6291456
# Optional server-only reset password verifier: scrypt$<salt hex>$<hash hex>.
# Generate with scripts/hash-world-password.mjs via stdin; never use a public client variable.
# Empty disables password-based multiplayer world reset.
WORLD_RESET_PASSWORD_HASH=
